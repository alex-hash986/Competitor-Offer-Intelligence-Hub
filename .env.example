# Локальный запуск Uvicorn использует SQLite.
DATABASE_URL=sqlite:///./competitor_intel.db

# Docker Compose передаёт контейнеру свой DATABASE_URL для PostgreSQL 16.
# Укажите собственный пароль для развёртывания за пределами локального демо.
POSTGRES_DB=competitor_intel
POSTGRES_USER=competitor_intel
POSTGRES_PASSWORD=competitor_intel_local

# Для реквизитов со спецсимволами задайте URL с percent-encoding.
# COMPOSE_DATABASE_URL=postgresql+psycopg://competitor_intel:competitor_intel_local@db:5432/competitor_intel
